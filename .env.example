# Free Supabase project → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Shared desk passcode (Amira types this once; no Vercel login)
DESK_PASSCODE=choose-a-passcode

# Make / Zapier / n8n webhook — customer stage texts + daily follow-up digest
# See docs/MAKE-AUTOMATION.md
AUTOMATION_WEBHOOK_URL=

# Protects /api/automation/follow-ups (Vercel Cron + Make Schedule)
CRON_SECRET=choose-a-long-secret

# How many days a caller can stay open / waiting_pay before a reminder (default 2)
FOLLOW_UP_AFTER_DAYS=2
